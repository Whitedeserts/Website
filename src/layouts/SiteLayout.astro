---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Personal website for Mohamed Ahmed.' } = Astro.props;
const siteUrl = (Astro.site?.toString() ?? 'https://mohamedahmed.ca').replace(/\/$/, '');
const canonicalUrl = new URL(Astro.url.pathname, `${siteUrl}/`).toString();
const socialImageUrl = new URL('/photo/mohammed-inspire-headshot-social.jpg', `${siteUrl}/`).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: canonicalUrl,
  name: title,
  description,
  mainEntity: {
    '@type': 'Person',
    name: 'Mohamed Ahmed',
    honorificSuffix: 'PhD',
    url: siteUrl,
    image: socialImageUrl,
    jobTitle: ['Lead Data Scientist', 'Adjunct Professor'],
    affiliation: [
      {
        '@type': 'Organization',
        name: 'Esri Canada',
        url: 'https://www.esri.ca/en-ca/home',
      },
      {
        '@type': 'CollegeOrUniversity',
        name: 'University of Calgary',
        url: 'https://www.ucalgary.ca/',
      },
    ],
    sameAs: [
      'https://www.linkedin.com/in/mohamedmmahmed/',
      'https://www.youtube.com/@GeospatialNerd',
      'https://scholar.google.com/citations?user=P0ZFKvwAAAAJ&hl=en',
    ],
    knowsAbout: [
      'GeoAI',
      'Geospatial Data Science',
      'Remote Sensing',
      'Earth Observation',
      'Oceanography',
      'Arctic marine carbon cycling',
      'Machine Learning',
    ],
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f3ea" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <style is:global>
      :root {
        color-scheme: light;
        --ink: #18231f;
        --muted: #616d66;
        --paper: #f8f3ea;
        --surface: #fffdf7;
        --line: #d8d0bf;
        --accent: #2f6f5e;
        --accent-strong: #1f4e43;
        --link: #337844;
        --link-hover: #8a6722;
        --gold: #c48736;
        --shadow: 0 18px 45px rgba(36, 31, 22, 0.1);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(circle at 10% 5%, rgba(196, 135, 54, 0.14), transparent 28rem),
          linear-gradient(135deg, #fbf6ec 0%, #eef3ec 48%, #f7f2e8 100%);
        color: var(--ink);
        font-family: 'Bricolage Grotesque', 'Inter Tight', 'Segoe UI', sans-serif;
        line-height: 1.6;
        overflow-x: hidden;
        position: relative;
      }

      .earth-background {
        inset: 0;
        opacity: 0.46;
        pointer-events: none;
        position: fixed;
        z-index: 0;
      }

      .earth-background::after {
        background: linear-gradient(
          90deg,
          rgba(251, 246, 236, 0.96) 0%,
          rgba(251, 246, 236, 0.8) 52%,
          rgba(251, 246, 236, 0.48) 100%
        );
        content: '';
        inset: 0;
        position: absolute;
      }

      .earth-background canvas {
        display: block;
        height: 100%;
        width: 100%;
      }

      a {
        color: var(--link);
        text-decoration-color: rgba(102, 120, 51, 0.42);
        text-underline-offset: 0.18em;
      }

      a:hover {
        color: var(--link-hover);
      }

      .shell {
        width: min(1120px, calc(100% - 32px));
        margin: 0 auto;
        position: relative;
        z-index: 1;
      }

      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 24px 0;
      }

      .brand {
        color: var(--ink);
        font-weight: 800;
        letter-spacing: 0;
        text-decoration: none;
      }

      .nav {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
      }

      .nav a {
        color: var(--muted);
        font-size: 0.95rem;
        font-weight: 700;
        text-decoration: none;
      }

      .nav a:hover {
        color: var(--accent-strong);
      }

      main {
        padding: 28px 0 64px;
      }

      .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
        gap: 40px;
        align-items: center;
        min-height: calc(100vh - 190px);
      }

      .eyebrow {
        color: var(--accent-strong);
        font-size: 0.88rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        margin: 0 0 16px;
        text-transform: uppercase;
      }

      .eyebrow a {
        color: inherit;
        text-decoration-color: rgba(47, 111, 94, 0.45);
      }

      h1,
      h2,
      h3 {
        line-height: 1.05;
        letter-spacing: 0;
      }

      h1 {
        font-size: clamp(2.35rem, 6.2vw, 4.9rem);
        margin: 0 0 22px;
        max-width: 9ch;
      }

      .hero-name {
        font-size: clamp(1.85rem, 4.7vw, 3.55rem);
        max-width: 100%;
        white-space: nowrap;
      }

      h2 {
        font-size: clamp(1.8rem, 4vw, 3.2rem);
        margin: 0 0 20px;
      }

      h3 {
        font-size: 1.18rem;
        margin: 0 0 10px;
      }

      .intro {
        color: var(--ink);
        font-size: clamp(1.18rem, 2.1vw, 1.55rem);
        max-width: 760px;
      }

      .details {
        display: grid;
        gap: 20px;
        margin: 34px 0 0;
        max-width: 760px;
      }

      .detail {
        border-left: 4px solid var(--accent);
        color: var(--muted);
        padding-left: 16px;
      }

      .detail-current {
        color: var(--ink);
        font-size: clamp(1.08rem, 1.55vw, 1.28rem);
        font-weight: 650;
        line-height: 1.4;
      }

      .detail-role {
        border-left-color: var(--accent-strong);
      }

      .detail-academic {
        border-left-color: var(--link);
      }

      .detail-interests {
        border-left-color: var(--gold);
        color: var(--ink);
        font-size: clamp(1rem, 1.35vw, 1.12rem);
      }

      .detail-label {
        color: var(--link-hover);
        display: block;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        margin-bottom: 5px;
        text-transform: uppercase;
      }

      .role-contact {
        color: var(--muted);
        display: grid;
        font-size: 0.92rem;
        font-style: normal;
        font-weight: 500;
        gap: 1px;
        margin-top: 8px;
      }

      .role-contact a {
        margin-top: 3px;
      }

      .interest-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
      }

      .interest-tags span {
        background: rgba(255, 253, 248, 0.65);
        border: 1px solid var(--line);
        border-radius: 999px;
        color: #4f5f2d;
        font-size: 0.92rem;
        font-weight: 650;
        line-height: 1.2;
        padding: 7px 11px;
      }

      .linkedin-cta {
        align-items: center;
        background: var(--accent-strong);
        border-radius: 999px;
        color: #fff;
        display: inline-flex;
        font-size: 0.84rem;
        font-weight: 800;
        justify-content: center;
        justify-self: start;
        padding: 7px 11px;
        text-decoration: none;
      }

      .linkedin-cta:hover {
        color: #fff;
        background: var(--gold);
      }

      .youtube-cta {
        align-items: center;
        background: var(--accent-strong);
        border: 0;
        border-radius: 999px;
        color: #fff;
        display: inline-flex;
        font-size: 0.84rem;
        font-weight: 800;
        justify-content: center;
        justify-self: start;
        padding: 7px 11px;
        text-decoration: none;
      }

      .youtube-cta:hover {
        background: var(--gold);
        color: #fff;
      }

      .youtube-window {
        align-items: stretch;
        background:
          linear-gradient(135deg, rgba(255, 253, 248, 0.9), rgba(238, 244, 239, 0.78)),
          radial-gradient(circle at 90% 10%, rgba(196, 135, 54, 0.18), transparent 20rem);
        border: 1px solid var(--line);
        border-radius: 8px;
        box-shadow: 0 10px 26px rgba(33, 27, 19, 0.07);
        display: grid;
        gap: 8px;
        overflow: hidden;
        padding: 16px 18px;
      }

      .youtube-heading-row {
        align-items: center;
        display: flex;
        gap: 8px;
      }

      .youtube-heading-row img {
        aspect-ratio: 1;
        border-radius: 999px;
        display: block;
        object-fit: cover;
        width: 34px;
      }

      .youtube-copy {
        display: grid;
        gap: 8px;
      }

      .youtube-copy h2 {
        font-size: clamp(1.25rem, 2.2vw, 1.65rem);
        margin: 0;
      }

      .youtube-copy p {
        color: var(--muted);
        font-size: 0.94rem;
        margin: 0;
      }

      .portrait-stack {
        display: grid;
        gap: 18px;
      }

      .portrait {
        border-radius: 18px;
        margin: 0;
        position: relative;
      }

      .portrait::before {
        background:
          radial-gradient(circle at 20% 18%, rgba(196, 135, 54, 0.18), transparent 13rem),
          rgba(238, 244, 239, 0.7);
        border: 1px solid rgba(47, 111, 94, 0.16);
        border-radius: 22px;
        content: '';
        inset: 12px -12px -12px 12px;
        position: absolute;
        z-index: -1;
      }

      .portrait img {
        aspect-ratio: 4 / 5;
        border: 1px solid rgba(33, 27, 19, 0.12);
        border-radius: 16px;
        box-shadow: 0 18px 42px rgba(33, 27, 19, 0.14);
        display: block;
        object-fit: cover;
        width: 100%;
      }

      .social-window {
        align-items: stretch;
        background:
          linear-gradient(135deg, rgba(255, 253, 248, 0.9), rgba(238, 244, 239, 0.78)),
          radial-gradient(circle at 90% 10%, rgba(196, 135, 54, 0.18), transparent 20rem);
        border: 1px solid var(--line);
        box-shadow: 0 10px 26px rgba(33, 27, 19, 0.07);
        display: grid;
        gap: 8px;
        margin: 0;
        max-width: none;
        padding: 16px 18px;
      }

      .social-copy {
        align-content: center;
        display: grid;
        gap: 8px;
      }

      .social-copy h2 {
        font-size: clamp(1.25rem, 2.2vw, 1.65rem);
        margin: 0;
      }

      .social-copy p {
        color: var(--muted);
        font-size: 0.94rem;
        margin: 0;
      }

      .section {
        border-top: 1px solid var(--line);
        padding: 44px 0 0;
      }

      .section-intro {
        color: var(--muted);
        font-size: clamp(1rem, 1.5vw, 1.14rem);
        font-weight: 650;
        margin: -8px 0 22px;
        max-width: 780px;
      }

      .grid {
        display: grid;
        gap: 18px;
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .card {
        background: rgba(255, 253, 248, 0.72);
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 22px;
      }

      .support-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 14px;
      }

      .support-links a {
        align-items: center;
        border: 1px solid rgba(47, 111, 94, 0.25);
        border-radius: 999px;
        display: inline-flex;
        font-size: 0.86rem;
        font-weight: 800;
        padding: 6px 10px;
        text-decoration: none;
      }

      .meta,
      .tags,
      .date {
        color: var(--muted);
        font-size: 0.92rem;
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 16px;
      }

      .tag {
        border: 1px solid rgba(47, 111, 94, 0.25);
        border-radius: 999px;
        color: var(--accent-strong);
        padding: 3px 10px;
      }

      .help-grid {
        display: grid;
        gap: 18px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .help-card {
        background: rgba(255, 253, 248, 0.78);
        border: 1px solid var(--line);
        border-left: 4px solid var(--accent);
        border-radius: 8px;
        box-shadow: 0 14px 35px rgba(33, 27, 19, 0.08);
        display: grid;
        gap: 12px;
        padding: 22px;
      }

      .help-card h3,
      .help-card p {
        margin: 0;
      }

      .tech-grid {
        display: grid;
        gap: 16px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .tech-card {
        background: rgba(255, 253, 248, 0.66);
        border: 1px solid var(--line);
        border-radius: 8px;
        display: grid;
        gap: 12px;
        padding: 18px;
      }

      .tech-card h3 {
        font-size: 1.05rem;
        margin: 0;
      }

      .tech-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .tech-tags span {
        background: rgba(238, 244, 239, 0.7);
        border: 1px solid rgba(47, 111, 94, 0.18);
        border-radius: 999px;
        color: var(--muted);
        font-size: 0.86rem;
        font-weight: 700;
        line-height: 1.2;
        padding: 6px 9px;
      }

      .contact-cta {
        align-items: start;
        background: rgba(255, 253, 248, 0.78);
        border: 1px solid var(--line);
        border-left: 4px solid var(--gold);
        box-shadow: var(--shadow);
        display: grid;
        gap: 24px;
        grid-template-columns: minmax(0, 0.85fr) minmax(320px, 1.15fr);
        padding: clamp(22px, 4vw, 34px);
      }

      .contact-cta h2,
      .contact-cta p {
        margin: 0;
      }

      .contact-cta p:not(.eyebrow) {
        color: var(--muted);
        max-width: 660px;
      }

      .contact-linkedin {
        display: inline-flex;
        font-weight: 800;
        margin-top: 16px;
      }

      .contact-form {
        background: rgba(255, 253, 248, 0.82);
        border: 1px solid var(--line);
        border-radius: 8px;
        display: grid;
        gap: 14px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        padding: 18px;
      }

      .contact-form label {
        display: grid;
        gap: 5px;
      }

      .contact-form span {
        color: var(--accent-strong);
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .contact-form input,
      .contact-form select,
      .contact-form textarea {
        background: var(--surface);
        border: 1px solid rgba(33, 27, 19, 0.16);
        border-radius: 8px;
        color: var(--ink);
        font: inherit;
        padding: 10px 11px;
        width: 100%;
      }

      .contact-form input::placeholder,
      .contact-form textarea::placeholder {
        color: rgba(92, 103, 99, 0.72);
      }

      .contact-form textarea {
        resize: vertical;
      }

      .message-field {
        grid-column: 1 / -1;
      }

      .message-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        grid-column: 1 / -1;
      }

      .contact-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .contact-actions button,
      .message-actions button {
        background: var(--accent-strong);
        border: 0;
        border-radius: 999px;
        color: #fff;
        cursor: pointer;
        display: inline-flex;
        font: inherit;
        font-weight: 800;
        justify-content: center;
        padding: 10px 15px;
        text-decoration: none;
      }

      .email-app-link {
        align-items: center;
        background: var(--accent-strong);
        border-radius: 999px;
        color: #fff;
        display: inline-flex;
        font-weight: 800;
        justify-content: center;
        padding: 10px 15px;
        text-decoration: none;
      }

      .contact-actions button:hover,
      .message-actions button:hover,
      .email-app-link:hover {
        background: var(--gold);
        color: #fff;
      }

      .contact-secondary {
        align-items: center;
        border: 1px solid rgba(47, 111, 94, 0.25);
        border-radius: 999px;
        display: inline-flex;
        font-weight: 800;
        justify-content: center;
        padding: 10px 15px;
        text-decoration: none;
      }

      .form-note {
        color: var(--muted);
        font-size: 0.84rem;
      }

      .browser-fallback {
        background: rgba(238, 244, 239, 0.7);
        border: 1px solid rgba(47, 111, 94, 0.18);
        border-radius: 8px;
        grid-column: 1 / -1;
        display: grid;
        gap: 10px;
        margin-top: 4px;
        padding: 12px;
      }

      .browser-fallback[hidden] {
        display: none;
      }

      .fallback-heading {
        display: grid;
        gap: 4px;
      }

      .fallback-heading p {
        color: var(--muted);
        font-size: 0.9rem;
      }

      .browser-fallback textarea {
        min-height: 150px;
      }

      .content {
        background: rgba(255, 253, 248, 0.74);
        border: 1px solid var(--line);
        box-shadow: var(--shadow);
        margin: 32px auto 0;
        max-width: 820px;
        padding: clamp(24px, 5vw, 54px);
      }

      .content h1 {
        font-size: clamp(2.4rem, 6vw, 4.8rem);
        max-width: none;
      }

      .content-research h1 {
        font-size: clamp(1.7rem, 3.2vw, 2.4rem);
      }

      .content-work h1 {
        font-size: clamp(1.8rem, 3.4vw, 2.55rem);
      }

      .content h2 {
        border-top: 1px solid var(--line);
        font-size: clamp(1.55rem, 3vw, 2.3rem);
        margin-top: 34px;
        padding-top: 30px;
      }

      .content li + li {
        margin-top: 8px;
      }

      .content-section-research-areas ul {
        display: grid;
        gap: 16px;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        list-style: none;
        margin-left: 0;
        padding-left: 0;
      }

      .content-section-research-areas li {
        background: rgba(255, 253, 248, 0.76);
        border: 1px solid var(--line);
        border-left: 4px solid var(--accent);
        border-radius: 8px;
        box-shadow: 0 10px 26px rgba(33, 27, 19, 0.06);
        padding: 16px;
      }

      .content-section-research-areas li + li {
        margin-top: 0;
      }

      .content-section-what-i-build ul {
        display: grid;
        gap: 16px;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        list-style: none;
        margin-left: 0;
        padding-left: 0;
      }

      .content-section-what-i-build li {
        background: rgba(255, 253, 248, 0.76);
        border: 1px solid var(--line);
        border-left: 4px solid var(--accent);
        border-radius: 8px;
        box-shadow: 0 10px 26px rgba(33, 27, 19, 0.06);
        padding: 16px;
      }

      .content-section-what-i-build li + li {
        margin-top: 0;
      }

      .content-section-selected-speaking-and-workshops strong {
        color: var(--accent-strong);
      }

      .content-section-in-the-room {
        align-items: stretch;
        display: grid;
        gap: 16px;
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .content-section-in-the-room h2 {
        grid-column: 1 / -1;
      }

      .content-image {
        background: rgba(255, 253, 248, 0.78);
        border: 1px solid rgba(47, 111, 94, 0.2);
        border-radius: 8px;
        box-shadow: 0 12px 28px rgba(33, 27, 19, 0.08);
        display: flex;
        flex-direction: column;
        margin: 0;
        overflow: hidden;
      }

      .content-image img {
        aspect-ratio: 4 / 3;
        background: rgba(238, 244, 239, 0.78);
        display: block;
        flex: 0 0 auto;
        height: auto;
        object-fit: contain;
        width: 100%;
      }

      .content-image figcaption {
        color: var(--muted);
        font-size: 0.9rem;
        line-height: 1.45;
        margin: 0;
        padding: 12px 14px 14px;
      }

      .content-section-in-the-room .content-image figcaption {
        flex: 1;
      }

      .content-section-selected-projects-and-research-partnerships h3 {
        color: var(--accent-strong);
        font-size: clamp(1.16rem, 2vw, 1.42rem);
        margin: 28px 0 6px;
      }

      .content-section-selected-projects-and-research-partnerships h3 + p {
        color: var(--link-hover);
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.82rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        margin-top: 0;
        text-transform: uppercase;
      }

      .content-section-selected-active-research h3 {
        font-size: clamp(1.16rem, 2vw, 1.42rem);
        margin: 24px 0 8px;
      }

      .content-section-selected-active-research p {
        margin: 0 0 10px;
      }

      .content-section-selected-active-research em {
        color: var(--muted);
        font-size: 0.94rem;
      }

      .thesis-line {
        color: var(--muted);
        display: block;
        font-size: 0.94rem;
        margin-top: 8px;
      }

      .writing-page {
        display: grid;
        gap: 44px;
      }

      .writing-hero {
        max-width: 880px;
        padding: 34px 0 8px;
      }

      .writing-hero h1 {
        font-size: clamp(1.45rem, 2.7vw, 2rem);
        max-width: 30ch;
      }

      .source-link {
        display: inline-flex;
        font-weight: 800;
        margin-top: 18px;
      }

      .writing-section {
        border-top: 1px solid var(--line);
        display: grid;
        gap: 22px;
        padding-top: 34px;
      }

      .section-heading-row {
        display: grid;
        gap: 8px;
      }

      .section-heading-row .eyebrow,
      .section-heading-row h2 {
        margin: 0;
      }

      .blog-grid {
        display: grid;
        gap: 22px;
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .blog-card {
        background: rgba(255, 253, 248, 0.78);
        border: 1px solid var(--line);
        border-radius: 8px;
        box-shadow: 0 14px 35px rgba(33, 27, 19, 0.08);
        display: grid;
        grid-template-rows: auto 1fr;
        min-width: 0;
        overflow: hidden;
      }

      .blog-thumb {
        aspect-ratio: 16 / 10;
        background: #e7dfd2;
        display: block;
        overflow: hidden;
        position: relative;
      }

      .blog-thumb img {
        display: block;
        height: 100%;
        object-fit: cover;
        width: 100%;
      }

      .blog-card-body {
        display: grid;
        gap: 12px;
        padding: 20px;
      }

      .blog-meta-row {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .credit-badge {
        background: rgba(47, 111, 94, 0.1);
        border: 1px solid rgba(47, 111, 94, 0.22);
        border-radius: 999px;
        color: var(--accent-strong);
        font-size: 0.78rem;
        font-weight: 800;
        line-height: 1.2;
        padding: 4px 9px;
      }

      .blog-card h2 {
        font-size: clamp(1.15rem, 2vw, 1.45rem);
        margin: 0;
      }

      .blog-card p {
        margin: 0;
      }

      .resource-grid {
        display: grid;
        gap: 14px;
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .resource-card {
        background: rgba(255, 253, 248, 0.7);
        border: 1px solid var(--line);
        border-radius: 8px;
        display: grid;
        grid-template-rows: auto 1fr;
        min-width: 0;
        overflow: hidden;
      }

      .resource-thumb {
        aspect-ratio: 16 / 10;
        background: #e7dfd2;
        display: block;
        overflow: hidden;
        position: relative;
      }

      .resource-thumb img {
        display: block;
        height: 100%;
        object-fit: cover;
        width: 100%;
      }

      .resource-index {
        align-items: center;
        background: #fff;
        border: 1px solid rgba(196, 135, 54, 0.24);
        border-radius: 999px;
        color: #000;
        display: inline-flex;
        font-size: 0.8rem;
        font-weight: 900;
        height: 34px;
        justify-content: center;
        left: 12px;
        position: absolute;
        top: 12px;
        width: 34px;
      }

      .resource-card-body {
        padding: 18px;
      }

      .resource-topic {
        color: var(--muted);
        font-size: 0.86rem;
        font-weight: 800;
        margin: 0 0 8px;
      }

      .resource-card h3 {
        font-size: 1.08rem;
        line-height: 1.2;
        margin: 0;
      }

      .footer {
        border-top: 1px solid var(--line);
        color: var(--muted);
        padding: 26px 0 40px;
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
      }

      @media (max-width: 800px) {
        .site-header,
        .hero {
          align-items: flex-start;
          grid-template-columns: 1fr;
        }

        .site-header {
          flex-direction: column;
        }

        h1 {
          max-width: 10ch;
        }

        .grid {
          grid-template-columns: 1fr;
        }

        .blog-grid {
          grid-template-columns: 1fr;
        }

        .resource-grid {
          grid-template-columns: 1fr;
        }

        .help-grid {
          grid-template-columns: 1fr;
        }

        .tech-grid {
          grid-template-columns: 1fr;
        }

        .social-window {
          grid-template-columns: 1fr;
        }

        .contact-cta {
          grid-template-columns: 1fr;
        }

        .contact-actions {
          justify-content: flex-start;
        }

        .content-section-research-areas ul {
          grid-template-columns: 1fr;
        }

        .content-section-what-i-build ul {
          grid-template-columns: 1fr;
        }

        .content-section-in-the-room {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .earth-background {
          opacity: 0.28;
        }

        .earth-background::after {
          background: linear-gradient(
            180deg,
            rgba(248, 244, 237, 0.97) 0%,
            rgba(248, 244, 237, 0.84) 58%,
            rgba(248, 244, 237, 0.6) 100%
          );
        }
      }

      @media (max-width: 560px) {
        .content-section-in-the-room {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <div class="earth-background" aria-hidden="true">
      <canvas data-earth-canvas></canvas>
    </div>
    <header class="shell site-header">
      <a class="brand" href="/">Mohamed Ahmed</a>
      <nav class="nav" aria-label="Main navigation">
        <a href="/about">About</a>
        <a href="/research">Research</a>
        <a href="/work">Work</a>
        <a href="/speaking">Speaking</a>
        <a href="/writing">Writing</a>
      </nav>
    </header>
    <main class="shell">
      <slot />
    </main>
    <script is:inline>
      document.querySelectorAll('a[href]').forEach((link) => {
        if (!(link instanceof HTMLAnchorElement)) return;

        const href = link.getAttribute('href') || '';
        const isNonBrowserLink =
          href.startsWith('mailto:') || href.startsWith('tel:') || href.startsWith('#');

        if (isNonBrowserLink) return;

        const url = new URL(href, window.location.href);
        const isExternalWebLink =
          (url.protocol === 'http:' || url.protocol === 'https:') &&
          url.origin !== window.location.origin;

        if (!isExternalWebLink) return;

        link.target = '_blank';
        link.rel = [
          ...new Set(['noopener', 'noreferrer', ...link.rel.split(' ').filter(Boolean)]),
        ].join(' ');
      });
    </script>
    <script>
      const loadEarthBackground = async () => {
        const THREE = await import('three');
        const canvas = document.querySelector('[data-earth-canvas]');

        if (!(canvas instanceof HTMLCanvasElement)) return;

        const renderer = new THREE.WebGLRenderer({
          alpha: true,
          antialias: true,
          canvas,
          powerPreference: 'high-performance',
          preserveDrawingBuffer: true,
        });
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100);
        const group = new THREE.Group();
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        camera.position.set(0, 0, 8);
        scene.add(group);

        const earth = new THREE.Mesh(
          new THREE.SphereGeometry(2.05, 72, 72),
          new THREE.MeshStandardMaterial({
            color: 0xdfeee8,
            metalness: 0.05,
            opacity: 0.42,
            roughness: 0.9,
            transparent: true,
          }),
        );
        group.add(earth);

        const grid = new THREE.LineSegments(
          new THREE.WireframeGeometry(new THREE.SphereGeometry(2.075, 32, 18)),
          new THREE.LineBasicMaterial({ color: 0x0c6b5a, opacity: 0.28, transparent: true }),
        );
        group.add(grid);

        const dataPositions: number[] = [];
        for (let index = 0; index < 180; index += 1) {
          const y = 1 - (index / 179) * 2;
          const radius = Math.sqrt(1 - y * y);
          const theta = index * 2.399963229728653;
          dataPositions.push(
            Math.cos(theta) * radius * 2.13,
            y * 2.13,
            Math.sin(theta) * radius * 2.13,
          );
        }

        const points = new THREE.Points(
          new THREE.BufferGeometry().setAttribute(
            'position',
            new THREE.Float32BufferAttribute(dataPositions, 3),
          ),
          new THREE.PointsMaterial({
            color: 0xc9842d,
            opacity: 0.62,
            size: 0.03,
            transparent: true,
          }),
        );
        group.add(points);

        const orbitMaterial = new THREE.LineBasicMaterial({
          color: 0x064b40,
          opacity: 0.3,
          transparent: true,
        });
        for (let index = 0; index < 3; index += 1) {
          const curve = new THREE.EllipseCurve(
            0,
            0,
            2.65 + index * 0.18,
            2.65 + index * 0.18,
            0,
            Math.PI * 2,
            false,
            0,
          );
          const orbit = new THREE.Line(
            new THREE.BufferGeometry().setFromPoints(curve.getPoints(160)),
            orbitMaterial,
          );
          orbit.rotation.set(index * 0.72, index * 0.42, index * 0.38);
          group.add(orbit);
        }

        const satelliteRig = new THREE.Group();
        const satelliteGeometry = new THREE.SphereGeometry(0.036, 16, 16);
        const satelliteMaterial = new THREE.MeshBasicMaterial({
          color: 0xc9842d,
          opacity: 0.58,
          transparent: true,
        });
        const beamMaterial = new THREE.LineBasicMaterial({
          color: 0xc9842d,
          opacity: 0.12,
          transparent: true,
        });

        for (let index = 0; index < 7; index += 1) {
          const radius = 2.68 + (index % 3) * 0.18;
          const angle = index * 0.897 + 0.35;
          const satellite = new THREE.Mesh(satelliteGeometry, satelliteMaterial);
          const x = Math.cos(angle) * radius;
          const y = Math.sin(angle) * radius;
          satellite.position.set(x, y, 0);

          const beam = new THREE.Line(
            new THREE.BufferGeometry().setFromPoints([
              new THREE.Vector3(x, y, 0),
              new THREE.Vector3(x * 0.78, y * 0.78, 0),
            ]),
            beamMaterial,
          );

          const pivot = new THREE.Group();
          pivot.rotation.set(index * 0.53, index * 0.41, index * 0.29);
          pivot.add(beam);
          pivot.add(satellite);
          satelliteRig.add(pivot);
        }

        group.add(satelliteRig);

        scene.add(new THREE.AmbientLight(0xffffff, 1.5));
        const keyLight = new THREE.DirectionalLight(0xfff4df, 2.3);
        keyLight.position.set(-3, 4, 5);
        scene.add(keyLight);

        const resize = () => {
          const width = window.innerWidth;
          const height = window.innerHeight;
          renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
          renderer.setSize(width, height, false);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
          group.position.set(width > 900 ? 2.75 : 0.92, width > 900 ? 0.1 : -1.95, 0);
          group.scale.setScalar(width > 900 ? 1.05 : 0.74);
        };

        let frame = 0;
        const render = () => {
          frame = requestAnimationFrame(render);
          group.rotation.y += reducedMotion ? 0 : 0.0018;
          points.rotation.y -= reducedMotion ? 0 : 0.0008;
          satelliteRig.rotation.z += reducedMotion ? 0 : 0.0024;
          renderer.render(scene, camera);
        };

        resize();
        render();
        window.addEventListener('resize', resize);
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) {
            cancelAnimationFrame(frame);
          } else {
            render();
          }
        });
      };

      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(() => loadEarthBackground(), { timeout: 1200 });
      } else {
        setTimeout(() => loadEarthBackground(), 250);
      }
    </script>
  </body>
</html>

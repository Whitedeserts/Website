---

<SiteLayout
  title="Writing - Mohamed Ahmed"
  description="Technical writing by Mohamed Ahmed on GeoAI, ArcGIS, remote sensing, climate, and applied geospatial AI."
>
  <section class="writing-page">
    <div class="writing-hero">
      <p class="eyebrow">Writing</p>
      <h1>Exploring ideas, workflows, and emerging directions in GIS and geospatial AI</h1>
      <p class="intro">
        I write to make GeoAI and applied machine learning easier to understand,
        evaluate, and use. These articles connect research ideas with practical
        geospatial systems for GIS professionals, researchers, students,
        government teams, and technical leaders.
      </p>
      <a class="source-link" href="https://resources.esri.ca/authors/mohamed-ahmed" target="_blank" rel="noreferrer">
        View all on Esri Canada Resources
      </a>
    </div>

    <section class="writing-section" aria-labelledby="blogs-heading">
      <div class="section-heading-row">
        <p class="eyebrow">Blogs</p>
        <h2 id="blogs-heading">Esri Canada articles</h2>
      </div>
      <div class="blog-grid" aria-label="Esri Canada articles by Mohamed Ahmed">
      {
        posts.map((post, index) => (
          <article class="blog-card">
            <a class="blog-thumb" href={post.url} target="_blank" rel="noreferrer" aria-label={post.title}>
              <img src={post.image} alt="" loading="lazy" />
              <span class="resource-index">{String(index + 1).padStart(2, '0')}</span>
            </a>
            <div class="blog-card-body">
              <div class="blog-meta-row">
                <p class="date">{formatDate(post.date)}</p>
                {'credit' in post && <span class="credit-badge">{post.credit}</span>}
              </div>
              <h2><a href={post.url} target="_blank" rel="noreferrer">{post.title}</a></h2>
              <p>{post.description}</p>
            </div>
          </article>
        ))
      }
      </div>
    </section>

    <section class="writing-section" aria-labelledby="tutorials-heading">
      <div class="section-heading-row">
        <p class="eyebrow">Tutorials</p>
        <h2 id="tutorials-heading">Tutorials and GIS resources</h2>
      </div>
      <div class="resource-grid" aria-label="Tutorials and GIS resources by Mohamed Ahmed">
        {
          tutorials.map((tutorial, index) => (
            <article class="resource-card">
              <a class="resource-thumb" href={tutorial.url} target="_blank" rel="noreferrer" aria-label={tutorial.title}>
                <img src={tutorial.image} alt="" loading="lazy" />
                <span class="resource-index">{String(index + 1).padStart(2, '0')}</span>
              </a>
              <div class="resource-card-body">
                <p class="resource-topic">{tutorial.topic}</p>
                <h3><a href={tutorial.url} target="_blank" rel="noreferrer">{tutorial.title}</a></h3>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </section>
</SiteLayout>